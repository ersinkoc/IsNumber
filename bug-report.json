      "severity": "MEDIUM",
      "category": "Functional",
      "status": "FIXED",
      "title": "Inconsistent Numeric Literal String Coercion",
      "description": "Function blocked hexadecimal strings but incorrectly allowed octal and binary strings when allowCoercion: true",
      "files": [
        {
          "path": "src/index.ts",
          "lines": "43-54",
          "linesChanged": 12
        }
      ],
      "rootCause": "Regex pattern only checked for hexadecimal prefixes (/^[-+]?0[xX]/), missing octal (0o/0O) and binary (0b/0B) prefixes",
      "fix": {
        "description": "Updated regex to /^[-+]?0[xXoObB]/ to block all non-decimal numeric literals",
        "approach": "Minimal change - extended regex pattern to include all numeric literal prefixes",
        "validation": "Added 14 comprehensive test cases"
      },
      "impact": {
        "user": "HIGH - Prevents validation bypasses",
        "system": "LOW - No performance impact",
        "business": "MEDIUM - Improves library trust",
        "security": "MEDIUM - Prevents potential validation bypasses in security-sensitive contexts"
      },
      "testsAdded": 14,
      "regressionRisk": "LOW"
    },
